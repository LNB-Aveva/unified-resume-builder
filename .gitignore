# ============================
# Python
# ============================
# __pycache__/ = Python creates these folders to store compiled versions of your .py files
# so they load faster next time. We don't track them because they're auto-generated.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
dist/
build/

# ============================
# Node.js / React
# ============================
# node_modules/ = When you run "npm install", all 3rd-party libraries download here.
# This folder can be 200MB+ — we NEVER commit it. Others can recreate it from package.json.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/build/
frontend/.next/

# ============================
# Environment & Secrets
# ============================
# .env files contain API keys and passwords. NEVER commit these.
# If someone gets your .env file, they can use your API keys and rack up charges.
.env
.env.local
.env.*.local
*.pem
secrets/

# ============================
# IDEs and Editors
# ============================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================
# OS Files
# ============================
# These are invisible files your operating system creates. Not part of your project.
.DS_Store
Thumbs.db
desktop.ini

# ============================
# Testing & Coverage
# ============================
.coverage
htmlcov/
.pytest_cache/
coverage/

# ============================
# Security Audit Reports (local)
# ============================
.audit/

# ============================
# LaTeX Build Files
# ============================
*.aux
*.log
*.out
*.toc
*.synctex.gz

# ============================
# Misc
# ============================
*.pdf
!docs/**/*.pdf

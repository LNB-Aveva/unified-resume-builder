# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains real URLs that could be scraped.
# In production (Vercel), set these in Project Settings → Environment Variables.

# ── Backend API URL (required for all features) ──────────────────────────
# In local dev: your uvicorn backend
# In production: your Render backend URL
# Example: https://unified-resume-builder-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Site URL (used for SEO: canonical, OG tags, sitemap, robots.txt) ─────
# In local dev: leave blank or set to http://localhost:3000
# In production: your Vercel deployment URL — set this in Vercel dashboard
# Example: https://resumeai.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Supabase (required — authentication + database) ─────────────────────
# Get these from: supabase.com → Project Settings → API
# Auth requires both URL and anon key to be set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Google Analytics (optional) ─────────────────────────────────────────
# GA4 measurement ID. Consent-gated — only loads after user accepts cookies.
NEXT_PUBLIC_GA_ID=

# ── Google AdSense (optional) ───────────────────────────────────────────
# Publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Consent-gated — only loads after
# user accepts cookies. Also update frontend/public/ads.txt with this ID.
NEXT_PUBLIC_ADSENSE_ID=

# ── Sentry error tracking (optional) ───────────────────────────────────
# DSN from Sentry project settings. Captures browser + server errors.
# PII-safe: no request bodies, auth headers, or local variables sent.
NEXT_PUBLIC_SENTRY_DSN=

# ── Environment tag (optional) ─────────────────────────────────────────
# "production", "staging", or "development". Controls Sentry environment
# tag and shows a visual banner on non-production deployments.
# Vercel: set to "staging" for Preview, "production" for Production.
NEXT_PUBLIC_SENTRY_ENV=

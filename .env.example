# ============================
# Application Settings
# ============================
# APP_NAME = The name your app uses to identify itself in logs and API docs
APP_NAME=UnifiedResumeBuilder
# DEBUG = When True, shows detailed error messages (NEVER set True in production)
DEBUG=True
# API_VERSION = Helps version your API endpoints (e.g., /api/v1/resume)
API_VERSION=v1

# ============================
# AI/NLP API Keys
# ============================
# HuggingFace is our FREE AI provider for resume rewriting
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_key_here

# ============================
# Database (Supabase - Free Tier)
# ============================
# Get these from: https://supabase.com → New Project → Settings → API
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================
# Server Settings
# ============================
# HOST and PORT control where your backend API runs
HOST=0.0.0.0
PORT=8000

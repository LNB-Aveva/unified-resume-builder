# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# .env is for LOCAL development only. In production (Render), set these
# as environment variables in the Render dashboard instead.

# ── AI Features (required for /summary, /rewrite, /cover-letter) ────────
# Get a free HuggingFace API key at: https://huggingface.co/settings/tokens
# Click "New token" → type: "Read" → copy the key (starts with hf_...)
HUGGINGFACE_API_KEY=hf_your_key_here

# Cost guardrails for AI inference. These in-memory UTC-day counters reset on
# process restart; keep provider-side spend limits enabled as the hard ceiling.
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=500
AI_PREVIEW_DAILY_IP_LIMIT=5

# ── Supabase JWT verification (required for authenticated API routes) ────
# Get from Supabase dashboard → Settings → API → JWT Secret
# Without this, protected routes (score, gap, compliance, rewrite,
# summary, cover-letter, export) return 503.
SUPABASE_JWT_SECRET=

# ── Production CORS (set in Render dashboard, not needed locally) ────────
# Your deployed Vercel frontend URL. The backend uses this to allow
# cross-origin requests from production. Leave blank for local dev.
# Example: https://unified-resume-builder.vercel.app
FRONTEND_URL=
